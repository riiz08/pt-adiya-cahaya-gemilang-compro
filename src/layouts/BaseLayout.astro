---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Seo from '../components/Seo.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Component (Meta, OG, Twitter, Canonical, JSON-LD) -->
    <Seo title={title} description={description} canonical={canonical} />
    
    <!-- Google Fonts: Poppins (Heading) & Inter (Body) dengan font-display: swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-bg-base text-text-main font-body antialiased overflow-x-hidden selection:bg-accent/20 selection:text-primary">
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton floating={true} />
  </body>
</html>
