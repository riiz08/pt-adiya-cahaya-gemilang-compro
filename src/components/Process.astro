---
import { processData } from '../data/process';
import { siteConfig } from '../data/site';
---

<section id="alur" class="py-20 sm:py-24 bg-bg-alt border-b border-slate-200/60 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Pola Konsisten: Eyebrow, Judul, Deskripsi Singkat) -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <span class="inline-block text-xs font-heading font-bold uppercase tracking-widest text-primary bg-primary/10 px-3 py-1 rounded-full mb-3">
        {processData.eyebrow}
      </span>
      <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-primary-dark tracking-tight leading-tight mb-4">
        {processData.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
        {processData.description}
      </p>
    </div>

    <!-- Steps Grid (6 Langkah) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 mb-16">
      {processData.steps.map((stepItem) => (
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/90 shadow-xs hover:shadow-md transition-all duration-300 relative overflow-hidden group">
          <!-- Step Number Watermark / Badge -->
          <div class="flex items-center justify-between mb-6">
            <span class="w-10 h-10 rounded-xl bg-primary text-white font-heading font-bold text-base flex items-center justify-center shadow-xs">
              0{stepItem.step}
            </span>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
              Tahap {stepItem.step}
            </span>
          </div>

          <h3 class="text-xl font-heading font-bold text-primary-dark mb-3 group-hover:text-primary transition-colors">
            {stepItem.title}
          </h3>
          <p class="text-sm text-slate-600 leading-relaxed font-normal">
            {stepItem.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Blok Ajakan WhatsApp -->
    <div class="rounded-2xl bg-gradient-to-r from-primary to-primary-dark text-white p-8 sm:p-12 shadow-lg relative overflow-hidden">
      <!-- Background accent blur -->
      <div class="absolute -right-12 -top-12 w-64 h-64 rounded-full bg-accent/20 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-8 text-center lg:text-left">
        <div class="max-w-2xl">
          <span class="text-accent text-xs font-heading font-bold uppercase tracking-widest block mb-2">
            Langkah Awal Proyek
          </span>
          <h3 class="text-2xl sm:text-3xl font-heading font-bold leading-tight mb-3">
            {processData.ctaBlock.title}
          </h3>
          <p class="text-slate-200 text-sm sm:text-base leading-relaxed">
            {processData.ctaBlock.description}
          </p>
        </div>

        <div class="shrink-0 w-full sm:w-auto">
          <a
            href={siteConfig.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-accent hover:bg-[#b58f3e] text-slate-900 font-heading font-bold text-base shadow-md hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5"
          >
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.971.53 1.761.815 2.796.815 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.586-5.766-5.768-5.766zm9.969 5.766c0 5.518-4.482 10-10 10-1.745 0-3.377-.45-4.809-1.236l-5.191 1.36 1.385-5.064c-.879-1.488-1.385-3.226-1.385-5.06 0-5.518 4.482-10 10-10 5.518 0 10 4.482 10 10z"/>
            </svg>
            <span>{processData.ctaBlock.buttonLabel}</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

