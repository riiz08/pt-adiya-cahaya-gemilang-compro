---
import { siteConfig } from '../data/site';
import ContactForm from './ContactForm.astro';

// Link Google Maps pencarian alamat resmi
const googleMapsSearchUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(siteConfig.name + ' ' + siteConfig.address)}`;
---

<section id="kontak" class="py-20 sm:py-24 bg-white border-b border-slate-200/60 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Pola Konsisten: Eyebrow, Judul, Deskripsi Singkat) -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <span class="inline-block text-xs font-heading font-bold uppercase tracking-widest text-primary bg-primary/10 px-3 py-1 rounded-full mb-3">
        Kontak
      </span>
      <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-primary-dark tracking-tight leading-tight mb-4">
        Konsultasikan Proyek GRC Anda
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
        Hubungi kami untuk konsultasi teknis, estimasi anggaran biaya, atau jadwal survey pengukuran langsung ke lokasi proyek Anda.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Information Cards & Location -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Contact Information Card -->
        <div class="bg-bg-alt rounded-2xl p-6 sm:p-8 border border-slate-200/90 shadow-xs">
          <h3 class="text-xl font-heading font-bold text-primary-dark mb-6">
            Informasi Kontak & Workshop
          </h3>

          <div class="space-y-5 text-sm text-slate-700">
            <!-- Workshop Address -->
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-0.5">Alamat Workshop</span>
                <p class="font-medium text-slate-900 leading-relaxed">
                  {siteConfig.address}
                </p>
              </div>
            </div>

            <!-- Telepon -->
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-0.5">Telepon Langsung</span>
                <div class="space-y-0.5">
                  {siteConfig.phones.map((phone) => (
                    <div>
                      <a href={`tel:${phone.replace(/\s+/g, '')}`} class="font-medium text-primary hover:underline">
                        {phone}
                      </a>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-0.5">Email Korespondensi</span>
                <a href={`mailto:${siteConfig.email}`} class="font-medium text-primary hover:underline">
                  {siteConfig.email}
                </a>
              </div>
            </div>

            <!-- Jam Operasional (TODO: ganti jika ada jam kerja resmi terbaru) -->
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-0.5">Jam Operasional</span>
                <p class="font-medium text-slate-900">
                  Senin - Sabtu: 08.00 - 17.00 WIB
                </p>
                <p class="text-xs text-slate-500">Minggu & Libur Nasional: Tutup</p>
              </div>
            </div>

          </div>
        </div>

        <!-- Location Map Card (Tanpa iframe langsung untuk menjaga Lighthouse & Privacy) -->
        <div class="bg-bg-alt rounded-2xl p-6 sm:p-8 border border-slate-200/90 shadow-xs relative overflow-hidden">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-heading font-bold text-primary-dark">
              Lokasi Workshop
            </h3>
            <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
              Cibinong, Bogor
            </span>
          </div>

          <p class="text-sm text-slate-600 mb-6 leading-relaxed">
            Workshop dan fasilitas fabrikasi cetakan GRC kami berlokasi strategis di jalur utama Jalan Raya Jakarta - Bogor KM 41.
          </p>

          <div id="map-container" class="rounded-xl overflow-hidden bg-slate-200 aspect-[16/9] flex flex-col items-center justify-center p-4 text-center border border-slate-300/80 relative">
            <svg class="w-10 h-10 text-slate-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
            <p class="text-xs text-slate-600 font-medium mb-3">Klik untuk membuka peta interaktif di Google Maps</p>
            <a
              href={googleMapsSearchUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-primary hover:bg-primary-dark text-white text-xs font-semibold transition-all shadow-xs"
            >
              <span>Buka di Google Maps</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: Consultation Form -->
      <div class="lg:col-span-7">
        <ContactForm />
      </div>

    </div>

  </div>
</section>

