---
import { projectsData } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section id="proyek" class="py-20 sm:py-24 bg-white border-b border-slate-200/60 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Pola Konsisten: Eyebrow, Judul, Deskripsi Singkat) -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <span class="inline-block text-xs font-heading font-bold uppercase tracking-widest text-primary bg-primary/10 px-3 py-1 rounded-full mb-3">
        {projectsData.eyebrow}
      </span>
      <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-primary-dark tracking-tight leading-tight mb-4">
        {projectsData.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
        {projectsData.description}
      </p>
    </div>

    <!-- Grid 6 Kartu Proyek: 1 kolom di mobile, 2-3 kolom di desktop -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {projectsData.items.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

  </div>
</section>

