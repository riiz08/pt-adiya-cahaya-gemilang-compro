---
import { Image } from "astro:assets";
import logoImg from "../assets/logo.webp";
import { siteConfig } from "../data/site";

const currentYear = new Date().getFullYear();
---

<footer
  class="bg-primary-dark text-slate-300 border-t border-primary/50 relative overflow-hidden"
>
  <!-- Subtle decorative background accent -->
  <div
    class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-accent/5 blur-3xl pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-16 relative z-10"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10">
      <!-- Brand & Info Column -->
      <div class="lg:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <Image
            src={logoImg}
            alt={`Logo ${siteConfig.name}`}
            class="h-12 w-auto max-w-[120px] object-contain brightness-0 invert"
          />
          <div>
            <h2
              class="text-white font-heading font-bold text-lg leading-tight tracking-tight"
            >
              {siteConfig.name}
            </h2>
            <p class="text-accent text-xs font-semibold tracking-wide">
              {siteConfig.tagline}
            </p>
          </div>
        </div>

        <p class="text-slate-400 text-sm leading-relaxed max-w-sm pt-2">
          {siteConfig.description}
        </p>
      </div>

      <!-- Quick Navigation Column -->
      <div class="lg:col-span-3 space-y-4">
        <h3
          class="text-white font-heading font-semibold text-sm tracking-wider uppercase"
        >
          Navigasi Cepat
        </h3>
        <ul class="space-y-2.5 text-sm">
          {
            siteConfig.navLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-slate-400 hover:text-accent transition-colors flex items-center gap-1.5"
                >
                  <span class="text-accent/60 text-xs">&rsaquo;</span>
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact Info Column -->
      <div class="lg:col-span-4 space-y-4" id="kontak-info">
        <h3
          class="text-white font-heading font-semibold text-sm tracking-wider uppercase"
        >
          Kontak & Workshop
        </h3>

        <div class="space-y-3 text-sm text-slate-400">
          <!-- Alamat -->
          <div class="flex items-start gap-2.5">
            <svg
              class="w-5 h-5 text-accent shrink-0 mt-0.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <p class="leading-relaxed">
              {siteConfig.address}
            </p>
          </div>

          <!-- Telepon -->
          <div class="flex items-center gap-2.5">
            <svg
              class="w-5 h-5 text-accent shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            <div class="space-x-2">
              {
                siteConfig.phones.map((phone, idx) => (
                  <span>
                    <a
                      href={`tel:${phone.replace(/\s+/g, "")}`}
                      class="hover:text-accent transition-colors"
                    >
                      {phone}
                    </a>
                    {idx < siteConfig.phones.length - 1 && <span> / </span>}
                  </span>
                ))
              }
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-center gap-2.5">
            <svg
              class="w-5 h-5 text-accent shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <a
              href={`mailto:${siteConfig.email}`}
              class="hover:text-accent transition-colors"
            >
              {siteConfig.email}
            </a>
          </div>

          <!-- Direct WhatsApp Link Button -->
          <div class="pt-2">
            <a
              href={siteConfig.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-white text-xs font-semibold tracking-wide transition-colors border border-white/20"
            >
              <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
              <span>Hubungi via WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div
      class="border-t border-slate-800 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4"
    >
      <p>
        &copy; {currentYear}
        {siteConfig.name}. Seluruh hak cipta dilindungi.
      </p>
      <p class="text-slate-500">
        Spesialis Glass Fibre Reinforced Cement (GRC) - Cibinong, Bogor
      </p>
    </div>
  </div>
</footer>
