---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'Konsultasi & Solusi Bisnis',
    description: 'Layanan konsultasi komprehensif untuk membantu perencanaan, optimasi operasional, dan efisiensi strategi bisnis.',
    badge: 'Konsultasi'
  },
  {
    title: 'Pengadaan & Manajemen Proyek',
    description: 'Penyediaan dan pengelolaan kebutuhan proyek dengan transparansi, ketepatan waktu, dan standar mutu tinggi.',
    badge: 'Proyek'
  },
  {
    title: 'Dukungan Teknis & Operasional',
    description: 'Layanan dukungan purna jual dan operasional berkala untuk menjamin kelancaran aktivitas bisnis mitra kerja.',
    badge: 'Operasional'
  }
];
---

<Layout title="Layanan | PT Adiya Cahaya Gemilang">
  <!-- Page Header -->
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl font-extrabold mb-4">Layanan & Solusi</h1>
      <p class="text-slate-400 max-w-2xl mx-auto">
        Rangkaian layanan profesional kami yang dirancang untuk mendukung pertumbuhan dan kesuksesan organisasi Anda.
      </p>
    </div>
  </section>

  <!-- Service List -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {services.map((item) => (
          <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:shadow-md transition flex flex-col justify-between">
            <div>
              <span class="inline-block px-3 py-1 bg-blue-50 text-blue-700 text-xs font-semibold rounded-full mb-4">
                {item.badge}
              </span>
              <h2 class="text-xl font-bold text-slate-900 mb-3">{item.title}</h2>
              <p class="text-slate-600 text-sm leading-relaxed mb-6">
                {item.description}
              </p>
            </div>
            <a
              href="/contact"
              class="text-blue-600 font-medium text-sm hover:underline inline-flex items-center gap-1"
            >
              Konsultasikan Layanan &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

